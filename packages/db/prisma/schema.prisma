generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                 @id @default(autoincrement())
  email             String?             @unique
  name              String?
  number            String              @unique
  password          String
  OnRampTransaction OnRampTransaction[]
  Balance           Balance[]
  sentTransfers     p2pTransfer[]       @relation(name: "FromUserRelation")
  receivedTransfers p2pTransfer[]       @relation(name: "ToUserRelation")
}

model p2pTransfer {
  id         Int      @id @default(autoincrement())
  amount     Int
  timestamp  DateTime
  fromUserId Int
  fromUser   User     @relation(name: "FromUserRelation", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User     @relation(name: "ToUserRelation", fields: [toUserId], references: [id])
}

model Merchant {
  id           Int               @id @default(autoincrement())
  email        String            @unique
  name         String?
  auth_type    AuthType
  paymentLinks PaymentLink[]
  payments     MerchantPayment[]
  customers    MerchantCustomer[]
  settlements  Settlement[]
}

model PaymentLink {
  id          Int               @id @default(autoincrement())
  merchantId  Int
  slug        String            @unique
  title       String
  description String?
  amount      Int
  status      PaymentLinkStatus @default(Active)
  createdAt   DateTime          @default(now())
  merchant    Merchant          @relation(fields: [merchantId], references: [id])
  payments    MerchantPayment[]

  @@index([merchantId, createdAt])
}

model MerchantCustomer {
  id         Int               @id @default(autoincrement())
  merchantId Int
  name       String
  email      String?
  phone      String?
  createdAt  DateTime          @default(now())
  merchant   Merchant          @relation(fields: [merchantId], references: [id])
  payments   MerchantPayment[]

  @@index([merchantId, createdAt])
}

model MerchantPayment {
  id            Int                  @id @default(autoincrement())
  merchantId    Int
  paymentLinkId Int?
  customerId    Int?
  reference     String               @unique
  amount        Int
  status        MerchantPaymentStatus @default(Pending)
  createdAt     DateTime             @default(now())
  paidAt        DateTime?
  merchant      Merchant             @relation(fields: [merchantId], references: [id])
  paymentLink   PaymentLink?         @relation(fields: [paymentLinkId], references: [id])
  customer      MerchantCustomer?    @relation(fields: [customerId], references: [id])

  @@index([merchantId, createdAt])
  @@index([paymentLinkId])
}

model Settlement {
  id         Int              @id @default(autoincrement())
  merchantId Int
  reference  String           @unique
  amount     Int
  status     SettlementStatus @default(Pending)
  createdAt  DateTime         @default(now())
  settledAt  DateTime?
  merchant   Merchant         @relation(fields: [merchantId], references: [id])

  @@index([merchantId, createdAt])
}

model OnRampTransaction {
  id        Int          @id @default(autoincrement())
  status    OnRampStatus
  token     String       @unique
  provider  String
  amount    Int
  startTime DateTime
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
}

model Balance {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  amount Int
  locked Int
  user   User @relation(fields: [userId], references: [id])
}

enum OnRampStatus {
  Pending
  Completed
  Failed
}

enum AuthType {
  Google
}

enum PaymentLinkStatus {
  Active
  Archived
}

enum MerchantPaymentStatus {
  Pending
  Completed
  Failed
}

enum SettlementStatus {
  Pending
  Processing
  Completed
  Failed
}
